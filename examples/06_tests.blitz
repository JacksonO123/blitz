struct Outer {
    pub m: M[];
}

struct M [T] {
    pub value: T;
    small: u16;
}

fn main() {
    {
        let outer = Outer {
            m = &[
                M<u32> { value = 1, small = 1u16 },
                M<u32> { value = 2, small = 2u16 },
                M<u32> { value = 3, small = 3u16 },
                M<u32> { value = 4, small = 4u16 },
                M<u32> { value = 5, small = 5u16 }
            ]
        };

        let thing = outer.m[3u64].value;
        let a = thing;
    }
}
